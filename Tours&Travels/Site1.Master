<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="Tours_Travels.Site1" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Tours & Travels</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- CDNs and Fonts -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://maxst.icons8.com/vue-static/landings/line-awesome/line-awesome/1.3.0/css/line-awesome.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- AOS Animation -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <!-- Custom Styles -->
    <style>
        :root {
            --midnight-green: #073b3a;
            --dartmouth-green: #0b6e4f;
            --pigment-green: #08a045;
            --mantis: #6bbf59;
            --ecru: #ddb771;
            --ivory-bg: #fcf8f3;
            --text-dark: #1f2937;
            --text-light: #4b5563;
        }

        body {
            font-family: "Poppins", sans-serif;
            background-color: var(--ivory-bg);
        }

        .heading-font {
            font-family: "Playfair Display", serif;
        }

        .container {
            max-width: 90%;
            margin: 0 auto;
        }

        @media (max-width: 768px) {
            .container {
                max-width: 95%;
            }
        }

        .hero-gradient {
            background: rgba(7, 59, 58, 0.6);
        }

        .navbar-scroll {
            transition: all 0.4s ease-out;
            background-color: var(--dartmouth-green);
            border-bottom: 1px solid var(--midnight-green);
        }

        .floating-icon {
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(0)
            }

            50% {
                transform: translateY(-10px)
            }
        }

        .parallax-bg {
            background-attachment: fixed;
            background-position: center;
            background-repeat: no-repeat;
            background-size: cover;
            position: relative;
        }

            .parallax-bg::before {
                content: "";
                position: absolute;
                inset: 0;
                background: rgba(7, 59, 58, 0.4);
            }

        .pulse-btn {
            animation: pulse 2s infinite;
            background-image: linear-gradient(to right, var(--pigment-green), var(--dartmouth-green));
        }

        @keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(8, 160, 69, .7)
            }

            70% {
                box-shadow: 0 0 0 10px rgba(8, 160, 69, 0)
            }

            100% {
                box-shadow: 0 0 0 0 rgba(8, 160, 69, 0)
            }
        }

        .section-padding {
            padding: 5rem 0;
        }

        @media(max-width:768px) {
            .section-padding {
                padding: 3rem 0;
            }
        }

        .gradient-text {
            background: linear-gradient(135deg, var(--dartmouth-green), var(--pigment-green));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .mobile-nav-container {
            display: flex;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }

            .mobile-nav-container::-webkit-scrollbar {
                display: none;
            }

        .footer-bg {
            position: relative;
            background-image: url("https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?auto=format&fit=crop&w=1920&q=80");
            background-size: cover;
            background-position: center;
        }

            .footer-bg::before {
                content: "";
                position: absolute;
                inset: 0;
                background-color: rgba(7, 59, 58, .7);
                z-index: 1;
            }

        .footer-content {
            position: relative;
            z-index: 2;
        }

        .why-us-card {
            transition: .3s;
            padding: 1.5rem;
            border-radius: .75rem;
            background: #fff;
            border: 1px solid #e5e7eb;
        }

            .why-us-card:hover {
                transform: scale(1.05);
                box-shadow: 0 10px 20px rgba(0, 0, 0, .1);
            }

                .why-us-card:hover .icon-bg {
                    background: var(--ecru) !important;
                }

                    .why-us-card:hover .icon-bg i {
                        color: var(--midnight-green) !important;
                    }

        .hero-title {
            text-shadow: 0 2px 10px rgba(0, 0, 0, .5);
        }

        /* Mobile Nav Enhancements */
        .mobile-nav-item {
            color: var(--text-light);
            transition: background-color 0.2s ease-in-out;
            padding-top: 0.25rem; /* Add some padding for the border */
            border-top: 3px solid transparent;
        }

            .mobile-nav-item.active {
                color: var(--dartmouth-green);
                border-top: 3px solid var(--dartmouth-green);
            }

            .mobile-nav-item:hover {
                background-color: #f3f4f6; /* A light gray for hover */
            }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body class="font-sans pb-16 lg:pb-0" style="color: var(--text-dark)">


    <nav id="navbar" class="fixed w-full z-50 transition-all duration-300 bg-midnight-green lg:bg-transparent">
        <div class="container px-4 sm:px-6 py-4">
            <div class="relative flex items-center justify-between">
                <!-- Brand/Logo -->
                <div class="flex items-center space-x-3">
                    <i class="las la-compass text-3xl floating-icon text-white" id="nav-logo-icon"></i>
                    <span class="text-xl sm:text-2xl font-bold text-white heading-font">Exploria</span>
                </div>

                <!-- Centered Desktop Menu -->
                <div class="hidden lg:flex items-center space-x-8 absolute left-1/2 -translate-x-1/2">
                    <a href="/Home.aspx" class="text-white hover:text-ecru transition-colors font-medium">Home</a>
                    <a href="/Destination.aspx" class="text-white hover:text-ecru transition-colors font-medium">Destinations</a>
                    <% if (Session["Role"] != null && Session["Role"].ToString() == "admin")
                        { %>
                    <a href="/AddDestinations.aspx" class="text-white hover:text-ecru transition-colors font-medium">Add-Destination
                    </a>
                    <a href="/AdminUserManagement.aspx" class="text-white hover:text-ecru transition-colors font-medium">User-Management
                    </a>
                    <a href="/AdminDestinations.aspx" class="text-white hover:text-ecru transition-colors font-medium">Destinations-Management
                    </a>
                    <% } %>
                    <% if (Session["Role"] != null && Session["Role"].ToString() == "users")
                        { %>
                    <a href="/MyBookings.aspx" class="text-white hover:text-ecru transition-colors font-medium">My-Bookings
                    </a>
                    <% } %>

                    <a href="/About.aspx" class="text-white hover:text-ecru transition-colors font-medium">About</a>
                    <a href="/Contact.aspx" class="text-white hover:text-ecru transition-colors font-medium">Contact</a>
                </div>

                <!-- Profile Section on Right -->
                <div class="hidden lg:flex items-center">
                    <a href="/Profile.aspx" class="flex items-center text-white hover:text-ecru transition-colors font-medium">
                        <i class="las la-user-circle text-2xl mr-2"></i>
                        <asp:Label ID="isAuth" runat="server" Text="Guest"></asp:Label>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <div>
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </div>

    <footer id="contact" class="py-12 sm:py-16 footer-bg">
        <div class="container mx-auto px-4 sm:px-6 footer-content">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <!-- Footer Column 1: Brand -->
                <div class="md:col-span-2 lg:col-span-1">
                    <div class="flex items-center space-x-2 mb-6">
                        <i class="bi bi-airplane text-2xl" style="color: var(--ecru)"></i>
                        <span class="text-xl sm:text-2xl font-bold heading-font" style="color: white">Wanderlust Tours</span>
                    </div>
                    <p class="mb-6 text-sm sm:text-base font-light" style="color: #cbd5e1">
                        Creating unforgettable travel experiences since 2010. Your adventure starts here.
                    </p>
                    <div class="flex space-x-4">
                        <a href="#" class="text-xl sm:text-2xl hover:opacity-80 transition-opacity" style="color: var(--ecru)"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-xl sm:text-2xl hover:opacity-80 transition-opacity" style="color: var(--ecru)"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-xl sm:text-2xl hover:opacity-80 transition-opacity" style="color: var(--ecru)"><i class="bi bi-twitter"></i></a>
                        <a href="#" class="text-xl sm:text-2xl hover:opacity-80 transition-opacity" style="color: var(--ecru)"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>
                <!-- Footer Column 2: Quick Links -->
                <div>
                    <h3 class="text-lg sm:text-xl font-bold mb-6 heading-font" style="color: var(--ecru)">Quick Links</h3>
                    <ul class="space-y-3">
                        <li><a href="/About.aspx" class="text-sm sm:text-base font-light hover:text-white transition-colors" style="color: #cbd5e1">About Us</a></li>
                        <li><a href="/Destinations.aspx" class="text-sm sm:text-base font-light hover:text-white transition-colors" style="color: #cbd5e1">Destinations</a></li>
                        <li><a href="/Packages.aspx" class="text-sm sm:text-base font-light hover:text-white transition-colors" style="color: #cbd5e1">Tour Packages</a></li>
                        <li><a href="/Contact.aspx" class="text-sm sm:text-base font-light hover:text-white transition-colors" style="color: #cbd5e1">Contact</a></li>
                    </ul>
                </div>
                <!-- Footer Column 3: Support -->
                <div>
                    <h3 class="text-lg sm:text-xl font-bold mb-6 heading-font" style="color: var(--ecru)">Support</h3>
                    <ul class="space-y-3">
                        <li><a href="#" class="text-sm sm:text-base font-light hover:text-white transition-colors" style="color: #cbd5e1">Help Center</a></li>
                        <li><a href="#" class="text-sm sm:text-base font-light hover:text-white transition-colors" style="color: #cbd5e1">Travel Insurance</a></li>
                        <li><a href="#" class="text-sm sm:text-base font-light hover:text-white transition-colors" style="color: #cbd5e1">Booking Terms</a></li>
                        <li><a href="#" class="text-sm sm:text-base font-light hover:text-white transition-colors" style="color: #cbd5e1">Privacy Policy</a></li>
                    </ul>
                </div>
                <!-- Footer Column 4: Contact Info -->
                <div>
                    <h3 class="text-lg sm:text-xl font-bold mb-6 heading-font" style="color: var(--ecru)">Contact Info</h3>
                    <div class="space-y-4">
                        <div class="flex items-start"><i class="bi bi-geo-alt mr-3 mt-1" style="color: var(--ecru)"></i><span class="text-sm sm:text-base font-light" style="color: #cbd5e1">123 Travel Street, Adventure City</span></div>
                        <div class="flex items-center"><i class="bi bi-telephone mr-3" style="color: var(--ecru)"></i><span class="text-sm sm:text-base font-light" style="color: #cbd5e1">+1 (555) 123-4567</span></div>
                        <div class="flex items-center"><i class="bi bi-envelope mr-3" style="color: var(--ecru)"></i><span class="text-sm sm:text-base font-light" style="color: #cbd5e1">info@wanderlusttours.com</span></div>
                    </div>
                </div>
            </div>
            <div class="mt-8 sm:mt-12 pt-6 sm:pt-8 text-center" style="border-top: 1px solid var(--dartmouth-green)">
                <p class="text-sm sm:text-base font-light" style="color: #94a3b8">
                    © 2025 Wanderlust Tours. All rights reserved. | Designed with ❤️ for adventurers
                </p>
            </div>
        </div>
    </footer>

    <!-- Mobile Bottom Navigation -->
    <nav class="lg:hidden fixed bottom-0 left-0 right-0 bg-white shadow-lg z-50" style="border-top: 1px solid #e2e8f0">
        <div class="mobile-nav-container h-16 w-full">

            <!-- Home (always visible) -->
            <a href="/Home.aspx" class="flex-shrink-0 w-24 flex flex-col items-center justify-center text-center mobile-nav-item">
                <i class="las la-home text-2xl"></i><span class="text-xs font-medium">Home</span>
            </a>

            <!-- Destinations (always visible) -->
            <a href="/Destinations.aspx" class="flex-shrink-0 w-24 flex flex-col items-center justify-center text-center mobile-nav-item">
                <i class="las la-map-marked-alt text-2xl"></i><span class="text-xs font-medium">Popular</span>
            </a>

            <% if (Session["Role"] != null && Session["Role"].ToString() == "admin")
                { %>
            <!-- Admin Links -->
            <a href="/AddDestinations.aspx" class="flex-shrink-0 w-24 flex flex-col items-center justify-center text-center mobile-nav-item">
                <i class="las la-plus-circle text-2xl"></i><span class="text-xs font-medium">Add</span>
            </a>
            <a href="/AdminUserManagement.aspx" class="flex-shrink-0 w-24 flex flex-col items-center justify-center text-center mobile-nav-item">
                <i class="las la-users-cog text-2xl"></i><span class="text-xs font-medium">Users</span>
            </a>
            <a href="/AdminDestinations.aspx" class="flex-shrink-0 w-24 flex flex-col items-center justify-center text-center mobile-nav-item">
                <i class="las la-tasks text-2xl"></i><span class="text-xs font-medium">Manage</span>
            </a>
            <% } %>

            <% if (Session["Role"] != null && Session["Role"].ToString() == "users")
                { %>
            <!-- User Link -->
            <a href="/MyBookings.aspx" class="flex-shrink-0 w-24 flex flex-col items-center justify-center text-center mobile-nav-item">
                <i class="las la-suitcase-rolling text-2xl"></i><span class="text-xs font-medium">Bookings</span>
            </a>
            <% } %>

            <!-- About -->
            <a href="/About.aspx" class="flex-shrink-0 w-24 flex flex-col items-center justify-center text-center mobile-nav-item">
                <i class="las la-info-circle text-2xl"></i><span class="text-xs font-medium">About</span>
            </a>

            <!-- Contact -->
            <a href="/Contact.aspx" class="flex-shrink-0 w-24 flex flex-col items-center justify-center text-center mobile-nav-item">
                <i class="las la-envelope text-2xl"></i><span class="text-xs font-medium">Contact</span>
            </a>

            <!-- Profile (always visible) -->
            <a href="/Profile.aspx" class="flex-shrink-0 w-24 flex flex-col items-center justify-center text-center mobile-nav-item">
                <i class="las la-user-circle text-2xl"></i><span class="text-xs font-medium">Profile</span>
            </a>

            <!-- Logout (always visible if logged in) -->
            <% if (Session["Role"] != null)
                { %>
            <a href="/Logout.aspx" class="flex-shrink-0 w-24 flex flex-col items-center justify-center text-center mobile-nav-item">
                <i class="las la-sign-out-alt text-2xl"></i><span class="text-xs font-medium">Logout</span>
            </a>
            <% }
            else
            { %>
            <a href="/Login.aspx" class="flex-shrink-0 w-24 flex flex-col items-center justify-center text-center mobile-nav-item">
                <i class="las la-sign-in-alt text-2xl"></i><span class="text-xs font-medium">Login</span>
            </a>
            <% } %>
        </div>
    </nav>


    <asp:ContentPlaceHolder ID="script" runat="server"></asp:ContentPlaceHolder>

    <script>
        AOS.init({ duration: 1200, once: true, offset: 100, easing: "ease-in-out-cubic" });

        // Navbar scroll effect
        window.addEventListener("scroll", function () {
            const navbar = document.getElementById("navbar");
            const navIcon = document.getElementById("nav-logo-icon");
            if (window.scrollY > 50) {
                navbar.classList.add("navbar-scroll");
                navbar.classList.remove("lg:bg-transparent");
                if (navIcon) navIcon.style.color = "var(--ecru)";
            } else {
                navbar.classList.remove("navbar-scroll");
                navbar.classList.add("lg:bg-transparent");
                if (navIcon) navIcon.style.color = "white";
            }
        });

        // --- Mobile Nav Functionality ---
        document.addEventListener("DOMContentLoaded", function () {
            const currentPagePath = window.location.pathname.toLowerCase();
            const navLinks = document.querySelectorAll('.mobile-nav-item');

            navLinks.forEach(link => {
                // FIX: Use link.pathname directly instead of constructing a new URL object.
                const linkPath = link.pathname.toLowerCase();

                // Highlight link if its path matches the current page path
                // Special check for root path to match Default.aspx
                if (linkPath === currentPagePath || (currentPagePath === '/' && linkPath.includes('default.aspx'))) {
                    link.classList.add('active');
                }
            });
        });


    </script>

</body>
</html>

