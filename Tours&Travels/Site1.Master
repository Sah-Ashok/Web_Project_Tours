              <!-- Column 4: Newsletter Signup -->
              <div class="footer-column" data-aos="fade-up" data-aos-delay="400">
                <h3 class="footer-column-title">Stay Updated</h3>
                <p class="footer-newsletter-text">Subscribe for travel deals and inspiration</p>
                
                <!-- Inline Newsletter Form - NO REQUIRED VALIDATION -->
                <div class="footer-newsletter-form" id="footerNewsletterForm">
                  <div class="footer-newsletter-input-group">
                    <input 
                      type="email" 
                      id="newsletterEmailInput"
                      class="footer-newsletter-input" 
                      placeholder="Your email address"
                      aria-label="Email for newsletter"
                     
                    />
                    <button type="button" class="footer-newsletter-btn" id="newsletterSubmitBtn" aria-label="Subscribe to newsletter" onclick="subscribeNewsletter()">
                      <!-- Heroicons: paper-airplane (send icon) -->
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M3.478 2.405a.75.75 0 00-.926.94l2.432 7.905H13.5a.75.75 0 010 1.5H4.984l-2.432 7.905a.75.75 0 00.926.94 60.519 60.519 0 0018.445-8.986.75.75 0 000-1.218A60.517 60.517 0 003.478 2.405z" />
                      </svg>
                    </button>
                  </div>
                  <p class="footer-newsletter-privacy">
                    <!-- Heroicons: lock-closed -->
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd" />
                    </svg>
                    <span>We respect your privacy</span>
                  </p>
                </div>

                <!-- Contact Info - Heroicons -->
                <div class="footer-contact-items">
                  <a href="tel:+911234567890" class="footer-contact-item footer-contact-link">
                    <!-- Heroicons: phone -->
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 013.5 2h1.148a1.5 1.5 0 011.465 1.175l.716 3.223a1.5 1.5 0 01-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 006.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 011.767-1.052l3.223.716A1.5 1.5 0 0118 15.352V16.5a1.5 1.5 0 01-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 012.43 8.326 13.019 13.019 0 012 5V3.5z" clip-rule="evenodd" />
                    </svg>
                    <span>+91-1234567890</span>
                  </a>
                  <a href="mailto:info@exploria.com" class="footer-contact-item footer-contact-link">
                    <!-- Heroicons: envelope -->
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z" />
                      <path d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z" />
                    </svg>
                    <span>info@exploria.com</span>
                  </a>
                </div>
              </div>

