                            <a href="/Register.aspx">
                                <i class="las la-user-plus"></i>
                                Sign Up
                            </a>
                            <a href="/ForgetPassword.aspx">
                                <i class="las la-key"></i>
                                Forgot Password
                            </a>
                        <% } %>
                    </div>
