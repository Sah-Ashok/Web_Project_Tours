    <!-- Modern Footer - Enhanced 2025 -->
    <footer id="footer" class="modern-footer" role="contentinfo">
        
        <!-- Decorative Compass Rose -->
        <svg class="footer-decorative-compass" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
            <circle cx="100" cy="100" r="80" fill="none" stroke="currentColor" stroke-width="0.5"/>
            <circle cx="100" cy="100" r="60" fill="none" stroke="currentColor" stroke-width="0.5"/>
            <circle cx="100" cy="100" r="40" fill="none" stroke="currentColor" stroke-width="0.5"/>
            <line x1="100" y1="20" x2="100" y2="180" stroke="currentColor" stroke-width="0.5"/>
            <line x1="20" y1="100" x2="180" y2="100" stroke="currentColor" stroke-width="0.5"/>
            <line x1="35" y1="35" x2="165" y2="165" stroke="currentColor" stroke-width="0.5"/>
            <line x1="165" y1="35" x2="35" y2="165" stroke="currentColor" stroke-width="0.5"/>
            <polygon points="100,10 105,30 100,25 95,30" fill="currentColor"/>
            <polygon points="190,100 170,105 175,100 170,95" fill="currentColor"/>
            <polygon points="100,190 95,170 100,175 105,170" fill="currentColor"/>
            <polygon points="10,100 30,95 25,100 30,105" fill="currentColor"/>
        </svg>

        <!-- Main Footer Content -->
        <div class="footer-main-content">
          <div class="footer-container">
            <div class="footer-grid">
              
              <!-- Column 1: About -->
              <div class="footer-column" data-aos="fade-up" data-aos-delay="100">
                <!-- Logo -->
                <div class="footer-logo">
                  <i class="las la-paper-plane footer-logo-icon"></i>
                  <span class="footer-logo-text">Exploria</span>
                </div>
                
                <!-- Description -->
                <p class="footer-description">
                  Creating unforgettable travel experiences since 2010. Your adventure starts here with personalized itineraries and expert guidance.
                </p>
                
                <!-- Social Icons - Heroicons SVG -->
                <div class="footer-social-icons">
                  <a href="https://facebook.com/exploria" class="footer-social-icon" aria-label="Visit our Facebook page" target="_blank" rel="noopener">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
                  </a>
                  <a href="https://instagram.com/exploria" class="footer-social-icon" aria-label="Follow us on Instagram" target="_blank" rel="noopener">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                  </a>
                  <a href="https://twitter.com/exploria" class="footer-social-icon" aria-label="Follow us on Twitter" target="_blank" rel="noopener">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
                  </a>
                  <a href="https://linkedin.com/company/exploria" class="footer-social-icon" aria-label="Connect with us on LinkedIn" target="_blank" rel="noopener">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                  </a>
