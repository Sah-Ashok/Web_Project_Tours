/* ==========================================
   EXPLORIA TOURS - ULTRA PREMIUM LOGIN PAGE
   Split-Screen Design with Advanced Animations
   ========================================== */

:root {
    /* Primary Colors */
    --dartmouth-green: #0b6e4f;
    --pigment-green: #08a045;
    --mantis: #6bbf59;
    --emerald: #1d5e33;
    --emerald-dark: #164426;
    --emerald-light: #2a7d4a;
    --emerald-pale: #e8f4ed;
    --midnight-green: #0b3d2e;
    
    /* Accent Colors */
    --champagne-gold: #E5CBAF;
    --gold-rich: #c9a877;
    --gold-shimmer: #f5e8d8;
    
    /* Neutrals */
    --ivory-bg: #fcf8f3;
    --pearl-white: #ffffff;
    --text-dark: #1f2937;
    --text-light: #6b7280;
    --text-lighter: #9ca3af;
    
    /* Feedback Colors */
    --error-red: #dc2626;
    --success-green: #10b981;
    
    /* Shadows */
    --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.05);
    --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.12);
    --shadow-xl: 0 20px 60px rgba(0, 0, 0, 0.15);
    
    /* Transitions */
    --transition-fast: 0.2s ease;
    --transition-normal: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ==========================================
   RESET & BASE STYLES
   ========================================== */
*,
*::before,
*::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    font-feature-settings: 'liga', 'kern';
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
    background: var(--ivory-bg);
}

/* Skip to Content Link (Accessibility) */
.skip-to-content {
    position: fixed;
    top: -200px;
    left: 20px;
    background: var(--emerald);
    color: var(--pearl-white);
    padding: 14px 24px;
    text-decoration: none;
    border-radius: 12px;
    z-index: 10000;
    font-weight: 700;
    font-size: 15px;
    box-shadow: var(--shadow-lg);
    transition: top var(--transition-normal);
}

.skip-to-content:focus {
    top: 20px;
    outline: 3px solid var(--mantis);
    outline-offset: 3px;
}

/* ==========================================
   SPLIT SCREEN LAYOUT - MAIN CONTAINER
   ========================================== */
.login-split-container {
    display: flex;
    min-height: 100vh;
    width: 100%;
    background: var(--ivory-bg);
    position: relative;
    overflow: hidden;
}

/* Decorative Background Pattern (Right Side) */
.login-split-container::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    background-image: 
        radial-gradient(circle at 20% 30%, rgba(29, 94, 51, 0.04) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(107, 191, 89, 0.04) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
}

/* ==========================================
   LEFT PANEL - DECORATIVE SIDE
   ========================================== */
.absolute.inset-0.h-full.w-full {
    position: absolute;
    width: 50%;
    height: 100%;
    left: 0;
    top: 0;
    overflow: hidden;
    animation: fadeIn 0.8s ease-out;
}

.parallax-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    background-size: cover !important;
    background-position: center !important;
    background-repeat: no-repeat;
    transition: transform 0.5s ease-out;
    animation: slowZoom 20s ease-in-out infinite alternate;
}

@keyframes slowZoom {
    from { transform: scale(1); }
    to { transform: scale(1.1); }
}

.login-gradient-overlay {
    background: linear-gradient(135deg, 
        rgba(11, 110, 79, 0.85) 0%, 
        rgba(29, 94, 51, 0.90) 100%);
    z-index: 1;
}

/* Left Panel Content */
.absolute.inset-0.h-full.w-full::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    padding: 60px 80px;
    pointer-events: none;
}

/* Floating Decorative Elements */
.absolute.inset-0.h-full.w-full::before {
    content: '✈';
    position: absolute;
    font-size: 120px;
    color: rgba(255, 255, 255, 0.08);
    top: 15%;
    right: 10%;
    z-index: 2;
    animation: float 6s ease-in-out infinite;
}

@keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(10deg); }
}

/* Left Panel Content Container */
.left-panel-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px 80px;
    color: var(--pearl-white);
    animation: slideInLeft 0.8s ease-out 0.3s both;
}

@keyframes slideInLeft {
    from {
        opacity: 0;
        transform: translateX(-40px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

.left-panel-logo {
    width: 160px;
    margin-bottom: 60px;
    filter: brightness(0) invert(1);
}

.left-panel-tagline {
    font-size: 42px;
    font-weight: 700;
    color: var(--pearl-white);
    line-height: 1.2;
    margin-bottom: 16px;
    letter-spacing: -0.5px;
}

.left-panel-subtext {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.85);
    max-width: 400px;
    margin-bottom: 48px;
    line-height: 1.6;
}

/* Feature Highlights */
.feature-highlights {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 48px;
}

.feature-item {
    display: flex;
    align-items: center;
    gap: 12px;
    opacity: 0;
    animation: fadeInStagger 0.5s ease-out forwards;
}

.feature-item:nth-child(1) { animation-delay: 0.8s; }
.feature-item:nth-child(2) { animation-delay: 0.95s; }
.feature-item:nth-child(3) { animation-delay: 1.1s; }
.feature-item:nth-child(4) { animation-delay: 1.25s; }

@keyframes fadeInStagger {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.feature-icon {
    font-size: 20px;
    color: var(--champagne-gold);
}

.feature-text {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 500;
}

/* ==========================================
   RIGHT PANEL - LOGIN FORM
   ========================================== */
.relative.w-full.max-w-md {
    position: relative;
    width: 100%;
    max-width: 460px;
    margin-left: auto;
    margin-right: 80px;
    z-index: 10;
    animation: scaleIn 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.5s both;
}

@keyframes scaleIn {
    from {
        opacity: 0;
        transform: scale(0.95);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

/* ==========================================
   LOGIN CARD - PREMIUM STYLING
   ========================================== */
.login-card {
    background: var(--pearl-white);
    border-radius: 24px;
    padding: 48px 40px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.12),
                0 8px 24px rgba(0, 0, 0, 0.08);
    border: 1px solid rgba(29, 94, 51, 0.08);
    position: relative;
    overflow: visible;
}

/* Top Accent Bar */
.login-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, 
        var(--emerald) 0%, 
        var(--mantis) 50%, 
        var(--champagne-gold) 100%);
    border-radius: 24px 24px 0 0;
    background-size: 200% 100%;
    animation: gradientShift 3s ease-in-out infinite;
}

@keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
}

/* ==========================================
   HEADING SECTION
   ========================================== */
.text-center {
    text-align: center;
}

.heading-font {
    font-size: 32px !important;
    font-weight: 800 !important;
    color: var(--text-dark) !important;
    margin-bottom: 12px;
    letter-spacing: -0.5px;
    animation: fadeInUp 0.6s ease-out 0.7s both;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.text-text-light {
    color: var(--text-light) !important;
}

.mt-2 {
    margin-top: 12px;
}

.text-md {
    font-size: 16px;
    margin-bottom: 36px;
    animation: fadeInUp 0.6s ease-out 0.9s both;
}

.font-light {
    font-weight: 400;
}

/* ==========================================
   MESSAGE LABEL
   ========================================== */
.block {
    display: block;
}

#lblMessage {
    padding: 12px 16px;
    border-radius: 10px;
    background: rgba(220, 38, 38, 0.1);
    border: 1px solid rgba(220, 38, 38, 0.3);
    animation: shake 0.5s ease-in-out;
}

@keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-10px); }
    75% { transform: translateX(10px); }
}

/* ==========================================
   FORM INPUTS - MODERN DESIGN
   ========================================== */
.space-y-6 > * + * {
    margin-top: 24px;
}

.rounded-md {
    border-radius: 14px;
}

.shadow-sm {
    box-shadow: none;
}

.-space-y-px > * + * {
    margin-top: 0;
}

.mb-4 {
    margin-bottom: 24px !important;
}

/* Input Container */
.mb-4, .mb-4 + div {
    position: relative;
}

/* Floating Labels */
label.sr-only {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    left: 48px;
    font-size: 15px;
    color: var(--text-light);
    pointer-events: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    background: var(--pearl-white);
    padding: 0 6px;
    z-index: 2;
    clip: auto;
    width: auto;
    height: auto;
    overflow: visible;
}

/* Label Float on Focus/Fill */
.mb-4:focus-within label.sr-only,
.mb-4:has(input:not(:placeholder-shown)) label.sr-only {
    top: -12px;
    font-size: 13px;
    color: var(--emerald);
    font-weight: 600;
}

/* Input Field Styling */
.form-input {
    width: 100%;
    height: 58px !important;
    background: var(--pearl-white) !important;
    border: 2px solid var(--emerald-pale) !important;
    border-radius: 14px !important;
    padding: 0 20px 0 48px !important;
    font-size: 15px !important;
    color: var(--text-dark) !important;
    transition: all 0.3s ease;
    position: relative;
    animation: fadeInUp 0.6s ease-out calc(1.1s + var(--input-delay, 0s)) both;
}

#txtEmail {
    --input-delay: 0s;
}

#txtPassword {
    --input-delay: 0.15s;
}

.form-input::placeholder {
    color: transparent;
}

.form-input:focus {
    outline: none;
    border-color: var(--emerald) !important;
    box-shadow: 0 0 0 4px rgba(29, 94, 51, 0.1) !important;
}

.form-input:hover:not(:focus) {
    border-color: var(--emerald-light) !important;
}

/* Input Icons */
.mb-4::before {
    content: '📧';
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 20px;
    z-index: 2;
    transition: all 0.3s;
    opacity: 0.6;
}

.mb-4 + div::before {
    content: '🔒';
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 20px;
    z-index: 2;
    transition: all 0.3s;
    opacity: 0.6;
}

.mb-4:focus-within::before,
.mb-4 + div:focus-within::before {
    opacity: 1;
    transform: translateY(-50%) scale(1.1);
}

/* Password Toggle Button */
.password-toggle {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    width: 24px;
    height: 24px;
    cursor: pointer;
    color: var(--text-light);
    transition: all 0.3s;
    z-index: 3;
    background: none;
    border: none;
    font-size: 20px;
}

.password-toggle:hover {
    color: var(--emerald);
    transform: translateY(-50%) scale(1.15);
}

.password-toggle:active {
    transform: translateY(-50%) scale(0.95);
}

/* ==========================================
   REMEMBER ME & FORGOT PASSWORD
   ========================================== */
.flex.items-center.justify-between {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
    margin-top: -8px;
    animation: fadeInUp 0.6s ease-out 1.4s both;
}

/* Custom Checkbox */
.flex.items-center {
    display: flex;
    align-items: center;
    gap: 10px;
}

#chkRememberMe {
    appearance: none;
    -webkit-appearance: none;
    width: 20px;
    height: 20px;
    border: 2px solid var(--emerald-pale);
    border-radius: 6px;
    background: var(--pearl-white);
    cursor: pointer;
    position: relative;
    transition: all 0.3s;
    margin: 0;
}

#chkRememberMe:checked {
    background: linear-gradient(135deg, var(--emerald), var(--pigment-green));
    border-color: var(--emerald);
}

#chkRememberMe:checked::after {
    content: '✓';
    position: absolute;
    color: white;
    font-size: 14px;
    font-weight: 700;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0);
    animation: checkDraw 0.4s ease-out forwards;
}

@keyframes checkDraw {
    to {
        transform: translate(-50%, -50%) scale(1);
    }
}

#chkRememberMe:hover {
    border-color: var(--emerald);
}

#chkRememberMe:focus {
    outline: 2px solid var(--mantis);
    outline-offset: 2px;
}

/* Remember Me Label */
.ml-2 {
    margin-left: 10px;
}

.text-sm {
    font-size: 14px;
}

label[for="chkRememberMe"] {
    color: var(--text-dark);
    cursor: pointer;
    user-select: none;
    font-weight: 500;
}

/* Forgot Password Link */
#hlForgotPassword {
    font-size: 14px;
    color: var(--emerald) !important;
    font-weight: 600;
    text-decoration: none;
    position: relative;
    transition: color 0.3s;
}

#hlForgotPassword::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--champagne-gold);
    transition: width 0.3s ease;
}

#hlForgotPassword:hover {
    color: var(--emerald-dark) !important;
}

#hlForgotPassword:hover::after {
    width: 100%;
}

#hlForgotPassword:focus {
    outline: 2px solid var(--mantis);
    outline-offset: 4px;
    border-radius: 4px;
}

/* ==========================================
   SIGN IN BUTTON - PREMIUM DESIGN
   ========================================== */
.login-btn {
    width: 100%;
    height: 56px !important;
    background: linear-gradient(135deg, 
        var(--emerald) 0%, 
        var(--pigment-green) 100%) !important;
    border: none !important;
    border-radius: 14px !important;
    color: var(--pearl-white) !important;
    font-size: 16px !important;
    font-weight: 700 !important;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(29, 94, 51, 0.3) !important;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    animation: fadeInUp 0.6s ease-out 1.6s both;
}

.login-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(29, 94, 51, 0.4) !important;
    background: linear-gradient(135deg, 
        var(--emerald-dark) 0%, 
        var(--emerald) 100%) !important;
}

.login-btn:active {
    transform: translateY(0);
    box-shadow: 0 4px 12px rgba(29, 94, 51, 0.2) !important;
}

.login-btn:focus {
    outline: 3px solid var(--mantis);
    outline-offset: 3px;
}

/* Button Ripple Effect */
.login-btn::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
}

.login-btn:active::before {
    width: 300px;
    height: 300px;
}

/* Button Shimmer Effect */
.login-btn::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100px;
    height: 100%;
    background: linear-gradient(90deg, 
        transparent, 
        rgba(255, 255, 255, 0.3), 
        transparent);
    transform: skewX(-45deg);
    animation: shimmer 2s infinite 1s;
}

@keyframes shimmer {
    to {
        left: 200%;
    }
}

/* ==========================================
   SIGN UP SECTION
   ========================================== */
.text-center p {
    padding-top: 24px;
    border-top: 1px solid var(--emerald-pale);
    margin-top: 24px;
    animation: fadeInUp 0.6s ease-out 1.8s both;
}

.text-gray-600 {
    color: var(--text-light);
    font-size: 15px;
}

#hlSignUp {
    font-size: 15px;
    font-weight: 700 !important;
    color: var(--emerald) !important;
    text-decoration: none;
    margin-left: 6px;
    position: relative;
    transition: color 0.3s;
}

#hlSignUp::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--champagne-gold);
    transition: width 0.3s ease;
}

#hlSignUp:hover {
    color: var(--emerald-dark) !important;
}

#hlSignUp:hover::after {
    width: 100%;
}

#hlSignUp:focus {
    outline: 2px solid var(--mantis);
    outline-offset: 4px;
    border-radius: 4px;
}

/* ==========================================
   TRUST BADGES
   ========================================== */
.trust-badges {
    display: flex;
    justify-content: center;
    gap: 24px;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid rgba(29, 94, 51, 0.1);
    flex-wrap: wrap;
    animation: fadeInUp 0.6s ease-out 2s both;
}

.trust-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-light);
}

.trust-badge i {
    font-size: 18px;
    color: var(--mantis);
}

/* ==========================================
   RESPONSIVE DESIGN
   ========================================== */

/* Tablet (768px - 1024px) */
@media (max-width: 1024px) {
    .absolute.inset-0.h-full.w-full {
        width: 40%;
    }
    
    .left-panel-content {
        width: 40%;
        padding: 40px 50px;
    }
    
    .left-panel-tagline {
        font-size: 36px;
    }
    
    .left-panel-subtext {
        font-size: 16px;
    }
    
    .relative.w-full.max-w-md {
        margin-right: 50px;
        max-width: 420px;
    }
    
    .login-card {
        padding: 40px 32px;
    }
}

/* Mobile (< 768px) */
@media (max-width: 768px) {
    section.relative.min-h-screen {
        flex-direction: column;
        padding: 0;
    }
    
    /* Left Panel becomes Banner */
    .absolute.inset-0.h-full.w-full {
        position: relative;
        width: 100%;
        height: 300px;
    }
    
    .left-panel-content {
        width: 100%;
        height: 300px;
        padding: 40px 24px;
        justify-content: center;
        position: relative;
    }
    
    .left-panel-logo {
        width: 120px;
        margin-bottom: 20px;
    }
    
    .left-panel-tagline {
        font-size: 28px;
        margin-bottom: 12px;
    }
    
    .left-panel-subtext {
        font-size: 14px;
        margin-bottom: 24px;
    }
    
    .feature-highlights {
        display: none; /* Hide on mobile to save space */
    }
    
    /* Form Right Panel */
    .relative.w-full.max-w-md {
        margin: 0 auto;
        max-width: 100%;
        padding: 24px;
        width: 100%;
    }
    
    .login-card {
        padding: 32px 24px;
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    }
    
    .heading-font {
        font-size: 28px !important;
    }
    
    .text-md {
        font-size: 14px;
    }
    
    .form-input {
        height: 54px !important;
        font-size: 14px !important;
    }
    
    .login-btn {
        height: 52px !important;
        font-size: 15px !important;
    }
    
    .flex.items-center.justify-between {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }
    
    .trust-badges {
        gap: 16px;
    }
    
    .trust-badge {
        font-size: 12px;
    }
}

/* Extra Small Mobile (< 480px) */
@media (max-width: 480px) {
    .left-panel-content {
        height: 250px;
        padding: 30px 20px;
    }
    
    .left-panel-tagline {
        font-size: 24px;
    }
    
    .left-panel-subtext {
        font-size: 13px;
    }
    
    .login-card {
        padding: 28px 20px;
    }
    
    .heading-font {
        font-size: 24px !important;
    }
}

/* ==========================================
   ACCESSIBILITY - REDUCED MOTION
   ========================================== */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
    
    .parallax-bg {
        animation: none;
    }
    
    .login-btn::after {
        animation: none;
    }
}

/* ==========================================
   FOCUS VISIBLE (Accessibility)
   ========================================== */
*:focus-visible {
    outline: 3px solid var(--mantis);
    outline-offset: 2px;
    border-radius: 4px;
}

/* ==========================================
   LOADING STATE
   ========================================== */
.login-btn.loading {
    pointer-events: none;
    opacity: 0.7;
}

.login-btn.loading span {
    opacity: 0;
}

.login-btn.loading::before {
    content: '';
    position: absolute;
    width: 24px;
    height: 24px;
    border: 3px solid rgba(255, 255, 255, 0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
}

@keyframes spin {
    to { transform: translate(-50%, -50%) rotate(360deg); }
}

/* ==========================================
   SUCCESS STATE
   ========================================== */
.success-message {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0);
    background: var(--pearl-white);
    padding: 48px;
    border-radius: 24px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.2);
    text-align: center;
    z-index: 1000;
    animation: successPop 0.5s ease-out forwards;
}

@keyframes successPop {
    to {
        transform: translate(-50%, -50%) scale(1);
    }
}

.success-checkmark {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--mantis);
    margin: 0 auto 24px;
    position: relative;
    animation: checkmarkPop 0.6s ease-out;
}

.success-checkmark::after {
    content: '✓';
    position: absolute;
    color: white;
    font-size: 48px;
    font-weight: 700;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: checkmarkDraw 0.4s ease-out 0.3s both;
}

@keyframes checkmarkPop {
    0% {
        transform: scale(0);
    }
    50% {
        transform: scale(1.2);
    }
    100% {
        transform: scale(1);
    }
}

@keyframes checkmarkDraw {
    from {
        opacity: 0;
        transform: translate(-50%, -50%) scale(0);
    }
    to {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
    }
}

/* ==========================================
   ERROR TOAST
   ========================================== */
.error-toast {
    position: fixed;
    top: 100px;
    right: 24px;
    background: rgba(220, 38, 38, 0.95);
    color: white;
    padding: 16px 24px;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 10000;
    transform: translateX(400px);
    animation: slideInRight 0.4s ease-out forwards;
}

@keyframes slideInRight {
    to {
        transform: translateX(0);
    }
}

.error-toast i {
    font-size: 24px;
}

/* ==========================================
   DECORATIVE BACKGROUND PATTERN
   ========================================== */
body::before {
    content: '';
    position: fixed;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    background-image: 
        radial-gradient(circle at 20% 30%, rgba(29, 94, 51, 0.03) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(107, 191, 89, 0.03) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
}

/* ==========================================
   PRINT STYLES
   ========================================== */
@media print {
    .absolute.inset-0.h-full.w-full {
        display: none;
    }
    
    .login-card {
        box-shadow: none;
        border: 1px solid #ccc;
    }
}

/* END OF CSS */
